#pragma once

// The cloud layer as the path tracer sees it, through the common bindings: its shadow on the atmosphere's sun
// for next event estimation, and the layer over the sky on misses (the reflection dome).

#include "rtx/pass/clouds/cloud_common.slangh"

// Attenuates a light sample of the atmosphere's sun by the cloud layer above a world position. Only the
// atmosphere's sun carries the flag, so game lights and dome lights are untouched.
void applyCloudShadowToLightSample(inout LightSample lightSample, uint16_t lightIdx, vec3 worldPosition)
{
  if (!cb.cloudArgs.enabled || (cb.cloudArgs.flags & CLOUD_FLAG_SUN_SHADOWS) == 0 || lightIdx == uint16_t(0xffff))
  {
    return;
  }

  const DecodedPolymorphicLight light = decodePolymorphicLight(lights[lightIdx]);
  if (!decodedPolymorphicLightIsCloudShadowed(light))
  {
    return;
  }

  lightSample.radiance *= cloudSunTransmittance(CloudSunGrid, CloudShadowMap, CloudSampler, worldPosition, cb.cloudArgs, cb.atmosphereArgs);
}

// Glass whose transmitted ray leaves within 2 degrees (kCloudGlassMarchCosine) of the camera's ray shows the clouds
// the camera ray meets, fading to the dome's along the bent ray by 5 degrees (kCloudGlassDomeCosine). Thin-walled
// panes do not bend it, and panes with parallel faces only where their normal maps tilt the exit face against the
// entry, by about a degree; lenses bend it further.
static const float kCloudGlassMarchCosine = 0.99939f;
static const float kCloudGlassDomeCosine = 0.99619f;

float cloudGlassTransmissionWeight(float cosine)
{
  return saturate((cosine - kCloudGlassDomeCosine) / (kCloudGlassMarchCosine - kCloudGlassDomeCosine));
}

// Specular reflections smoother than kCloudGlossyMarchRoughness (isotropic roughness) take their sky's clouds from
// a march along the reflected ray (cloud_glossy.comp.slang), fading back to the dome by kCloudGlossyDomeRoughness,
// where the reflection's lobe spans several of the dome's texels.
static const float kCloudGlossyMarchRoughness = 0.01f;
static const float kCloudGlossyDomeRoughness = 0.03f;

float cloudGlossyReflectionWeight(float isotropicRoughness)
{
  return saturate((kCloudGlossyDomeRoughness - isotropicRoughness) / (kCloudGlossyDomeRoughness - kCloudGlossyMarchRoughness));
}

// Sky radiance seen along a world direction on a miss, with the cloud layer composited over it.
vec3 cloudSkyRadianceOnMiss(vec3 skyRadiance, vec3 worldDirection)
{
  if (!cb.cloudArgs.enabled)
  {
    return skyRadiance;
  }
  const vec3 dirYUp = normalize(cloudWorldToYUp(worldDirection, cb.isZUp != 0));
  return cloudCompositeOverSky(cloudSampleDome(CloudDome, CloudSampler, dirYUp, cb.cloudArgs), skyRadiance);
}
