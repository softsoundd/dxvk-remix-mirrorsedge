// A runtime value rather than a constant: the right floor depends on how fast the camera
// reveals new geometry. Expands at the SDK's five comparison sites, all of which are
// compiled where cb is in scope.
#ifndef SHARC_SAMPLE_NUM_THRESHOLD
#define SHARC_SAMPLE_NUM_THRESHOLD cb.sharcArgs.minSampleCount
#endif

