#pragma once

#include "rtx/pass/sharc/sharc_sdk.slangh"
#include "rtx/pass/sharc/sharc_binding_indices.h"
#include "rtx/utility/debug_view_indices.h"

layout(binding = SHARC_BINDING_HASH)
RWStructuredBuffer<HashGridKey> SharcHash;

layout(binding = SHARC_BINDING_ACCUMULATION)
RWStructuredBuffer<SharcAccumulationData> SharcAccumulation;

layout(binding = SHARC_BINDING_RESOLVED)
RWStructuredBuffer<SharcPackedData> SharcResolved;

// portalSpace defaults to main space: callers that only touch existing entries (resolve,
// the deferred flush, miss accumulation) never recompute a spatial key, so the value is
// unused there.
SharcParameters makeSharcParameters(uint portalSpace = PORTAL_SPACE_NONE) {
  SharcParameters p;
  p.hashGridParameters.portalSpace = portalSpace;
  p.hashGridParameters.cameraPosition = cb.sharcArgs.cameraPosition;
  p.hashGridParameters.logarithmBase = SHARC_GRID_LOGARITHM_BASE;
  p.hashGridParameters.sceneScale = cb.sharcArgs.gridScale;
  p.hashGridParameters.levelBias = 0.0f;
  p.hashGridData.capacity = cb.sharcArgs.capacity;
  p.hashGridData.hashEntriesBuffer = SharcHash;
  p.accumulationBuffer = SharcAccumulation;
  p.resolvedBuffer = SharcResolved;
  p.radianceScale = cb.sharcArgs.radianceScale;
  return p;
}
