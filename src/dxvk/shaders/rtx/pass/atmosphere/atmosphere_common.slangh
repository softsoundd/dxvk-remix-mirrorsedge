#pragma once

// Hillaire Physically-Based Atmospheric Scattering
// Based on "A Scalable and Production Ready Sky and Atmosphere Rendering Technique",
// Sebastien Hillaire, EGSR 2020. Equation numbers in comments refer to that paper.
//
// All distances are in kilometers and all coefficients in km^-1. Directions are Y-up unless a
// function documents otherwise; games with a Z-up world pass isZUp to have the swap done for them.

#include "rtx/utility/common.slangh"
#include "rtx/utility/math.slangh"
#include "rtx/pass/atmosphere/atmosphere_args.h"

// Constants
static const float kAtmosphereEpsilon = 1e-3f;
static const float kPi = 3.14159265358979323846f;
// Minimum altitude (km) of any point a march starts from. An origin exactly on the planet sphere makes
// the ray-sphere roots collapse to zero, and a ray leaving the surface then reads as a ground hit at
// distance zero; the multiscattering LUT's ground row, for one, would bake to nothing. Hillaire's
// implementation applies the same 10 m offset (PLANET_RADIUS_OFFSET).
static const float kPlanetRadiusOffset = 0.01f;

// Rayleigh phase function including molecular anisotropy (Chandrasekhar 1960):
// p = 3 / (16 pi) * ((1 + 3 gamma) + (1 - gamma) cos^2) / (1 + 2 gamma), gamma = rho / (2 - rho).
// gamma = 0 recovers the textbook 3 / (16 pi) (1 + cos^2).
float rayleighPhase(float cosTheta, float gamma) {
  const float factor = 3.0f / (16.0f * kPi);
  return factor * ((1.0f + 3.0f * gamma) + (1.0f - gamma) * cosTheta * cosTheta) / (1.0f + 2.0f * gamma);
}

// Henyey-Greenstein phase function
float hgPhase(float cosTheta, float g) {
  // Clamp g to prevent numerical issues and complete extinction at g=1.0
  // At g=1.0, the phase function becomes 0 everywhere, making Mie scattering invisible
  g = clamp(g, -0.999f, 0.999f);
  
  float g2 = g * g;
  float numerator = 1.0f - g2;
  float denominator = 4.0f * kPi * pow(1.0f + g2 - 2.0f * g * cosTheta, 1.5f);
  return numerator / max(denominator, kAtmosphereEpsilon);
}

// Draine (2003) phase function, normalised over the sphere. alpha = 0 is Henyey-Greenstein, alpha = 1 is
// Cornette-Shanks.
float drainePhase(float cosTheta, float g, float alpha) {
  g = clamp(g, -0.999f, 0.999f);

  const float g2 = g * g;
  const float normalization = (1.0f - g2) / (4.0f * kPi * (1.0f + alpha * (1.0f + 2.0f * g2) / 3.0f));
  const float denominator = pow(1.0f + g2 - 2.0f * g * cosTheta, 1.5f);
  return normalization * (1.0f + alpha * cosTheta * cosTheta) / max(denominator, kAtmosphereEpsilon);
}

// Analytic aerosol phase function: a Draine bulk lobe, optionally blended with a narrow HG lobe for the
// sharp forward peak (the sun's aureole) that the bulk lobe alone lacks.
float mieAnalyticPhase(float cosTheta, AtmosphereArgs args) {
  const float bulk = drainePhase(cosTheta, args.mieAnisotropy, args.miePhaseAlpha);
  if (args.mieForwardPeakWeight <= 0.0f) {
    return bulk;
  }

  const float peak = hgPhase(cosTheta, args.mieForwardPeakG);
  return lerp(bulk, peak, saturate(args.mieForwardPeakWeight));
}

// Tabulated aerosol phase function (Mie / T-matrix data of the selected aerosol type, per channel
// wavelength), a 1D LUT over u = sqrt(theta / pi) so the forward peak gets most of the texels. Linear
// between texel centres and clamped beyond them, which is how the CPU normalised it.
vec3 sampleAerosolPhaseLut(Texture2D phaseLut, float cosTheta, AtmosphereArgs args) {
  const float theta = acos(clamp(cosTheta, -1.0f, 1.0f));
  const float u = sqrt(theta / kPi);

  const int size = int(max(args.aerosolPhaseLutSize, 1u));
  const float coord = clamp(u * float(size) - 0.5f, 0.0f, float(size - 1));
  const int x0 = int(coord);
  const int x1 = min(x0 + 1, size - 1);
  const float weight = coord - float(x0);

  return max(mix(phaseLut.Load(int3(x0, 0, 0)).rgb, phaseLut.Load(int3(x1, 0, 0)).rgb, weight), vec3(0.0f));
}

// Aerosol phase function per channel wavelength: the tabulated one when the aerosol type provides it,
// otherwise the analytic lobe.
vec3 miePhase(float cosTheta, AtmosphereArgs args, Texture2D phaseLut) {
  if (args.miePhaseTabulated != 0) {
    return sampleAerosolPhaseLut(phaseLut, cosTheta, args);
  }

  return vec3(mieAnalyticPhase(cosTheta, args));
}

// Returns normalized density in [0, 1] for an altitude in km.
float exponentialDensity(float altitude, float scaleHeight) {
  return exp(-max(0.0f, altitude) / scaleHeight);
}

float rayleighDensity(float altitude, AtmosphereArgs args) {
  return exponentialDensity(altitude, args.rayleighScaleHeight);
}

// Aerosol density: the paper's exponential profile, or a well mixed boundary layer of unit density with a
// smooth top and an exponential tail above it, as in the OPAC aerosol climatology (Hess et al. 1998).
// atmMieDensity() in rtx_atmosphere.cpp mirrors this and must stay in step with it.
float mieDensity(float altitude, AtmosphereArgs args) {
  if (args.mieBoundaryLayerHeight <= 0.0f) {
    return exponentialDensity(altitude, args.mieScaleHeight);
  }

  const float aboveTop = altitude - args.mieBoundaryLayerHeight;
  const float tail = args.mieBoundaryLayerTailScale * exponentialDensity(aboveTop, args.mieScaleHeight);
  const float transitionWidth = max(args.mieBoundaryLayerTransition, kAtmosphereEpsilon);
  const float t = smoothstep(-transitionWidth, transitionWidth, aboveTop);

  return lerp(1.0f, tail, t);
}

// Ozone density profile (paper Section 4): a tent function of total width 2*ozoneLayerWidth centred
// on ozoneLayerAltitude, i.e. d_o(h) = max(0, 1 - |h - 25| / 15) for Earth.
float ozoneDensity(float altitude, AtmosphereArgs args) {
  const float halfWidth = max(args.ozoneLayerWidth, kAtmosphereEpsilon);
  return max(0.0f, 1.0f - abs(altitude - args.ozoneLayerAltitude) / halfWidth);
}

// Participating medium coefficients at a given altitude.
struct AtmosphereMedium {
  vec3 rayleighScattering;
  vec3 mieScattering;
  vec3 scattering;   // Rayleigh + Mie, the sigma_s of Equation 3
  vec3 extinction;   // sigma_t = sigma_s + sigma_a, including Mie and ozone absorption
};

AtmosphereMedium sampleAtmosphereMedium(float altitude, AtmosphereArgs args) {
  const float densityR = rayleighDensity(altitude, args);
  const float densityM = mieDensity(altitude, args);
  const float densityO3 = ozoneDensity(altitude, args);

  AtmosphereMedium medium;
  medium.rayleighScattering = args.rayleighScattering * densityR;
  medium.mieScattering = args.mieScattering * densityM;
  medium.scattering = medium.rayleighScattering + medium.mieScattering;
  // Rayleigh is treated as pure scattering; Mie and ozone contribute absorption (paper Table 1).
  medium.extinction = medium.scattering
                    + args.mieAbsorption * densityM
                    + args.ozoneAbsorption * densityO3;

  return medium;
}

// Ray-sphere intersection with improved numerical stability
// Returns true if intersection exists, outputs near and far intersection distances
bool intersectSphere(vec3 origin, vec3 direction, vec3 center, float radius, out float t0, out float t1) {
  vec3 oc = origin - center;
  float a = dot(direction, direction);
  float b = 2.0f * dot(oc, direction);
  float c = dot(oc, oc) - radius * radius;
  float discriminant = b * b - 4.0f * a * c;
  
  // Use a small positive threshold to handle grazing angles more robustly
  // This prevents precision issues when ray is nearly tangent to sphere
  const float kDiscriminantEpsilon = 1e-6f;
  if (discriminant < -kDiscriminantEpsilon) {
    t0 = t1 = -1.0f;
    return false;
  }
  
  // Clamp discriminant to zero for near-tangent cases
  discriminant = max(0.0f, discriminant);
  
  float sqrtDiscriminant = sqrt(discriminant);
  float inv2A = 0.5f / max(a, 1e-7f);  // Prevent division by zero
  
  // Use numerically stable formula to avoid catastrophic cancellation
  // When b > 0, use t0 = (-b - sqrt(disc)) / 2a, then t1 = c / (a * t0)
  // When b < 0, use t1 = (-b + sqrt(disc)) / 2a, then t0 = c / (a * t1)
  if (b > 0.0f) {
    t0 = (-b - sqrtDiscriminant) * inv2A;
    t1 = (abs(t0) > 1e-6f) ? (c / (a * t0)) : ((-b + sqrtDiscriminant) * inv2A);
  } else {
    t1 = (-b + sqrtDiscriminant) * inv2A;
    t0 = (abs(t1) > 1e-6f) ? (c / (a * t1)) : ((-b - sqrtDiscriminant) * inv2A);
  }
  
  // Ensure t0 <= t1
  if (t0 > t1) {
    float temp = t0;
    t0 = t1;
    t1 = temp;
  }
  
  return true;
}

// Nearest non-negative intersection distance, or -1 when the sphere is behind or missed.
float intersectSphereNearest(vec3 origin, vec3 direction, vec3 center, float radius) {
  float t0, t1;
  if (!intersectSphere(origin, direction, center, radius, t0, t1)) {
    return -1.0f;
  }

  if (t1 < 0.0f) {
    return -1.0f;
  }

  return t0 < 0.0f ? t1 : t0;
}

// Planet centre for a Y-up frame whose origin sits on the ground.
vec3 getPlanetCenter(AtmosphereArgs args) {
  return vec3(0.0f, -args.planetRadius, 0.0f);
}

// Shadowing of the atmosphere by the planet itself, the Vis term of Equation 4. Without this the
// atmosphere stays lit from below the horizon and the Earth's shadow cast into the air at sunset
// (paper Figure 9, bottom) cannot appear.
float evalPlanetShadow(vec3 samplePos, vec3 sunDir, AtmosphereArgs args) {
  // Nudge the test sphere down slightly so samples sitting exactly on the ground are not
  // self shadowed by floating point error.
  const float shadowRadius = args.planetRadius * (1.0f - 1e-5f);
  return intersectSphereNearest(samplePos, sunDir, getPlanetCenter(args), shadowRadius) >= 0.0f
    ? 0.0f
    : 1.0f;
}

// Bruneton's half texel aware remap, so the LUT edges land exactly on the parameter range bounds.
float unitRangeToTextureCoord(float x, uint textureSize) {
  const float size = float(max(textureSize, 1u));
  return 0.5f / size + saturate(x) * (1.0f - 1.0f / size);
}

float textureCoordToUnitRange(float u, uint textureSize) {
  const float size = float(max(textureSize, 1u));
  return saturate((u - 0.5f / size) / (1.0f - 1.0f / size));
}

// Manual bilinear fetch with clamped addressing. The ray tracing passes have no sampler bound for
// the atmosphere LUTs, so all LUT reads go through Load to keep the bake and runtime paths identical.
vec3 sampleLut2DBilinearClamp(Texture2D lut, vec2 uv, int width, int height) {
  // Clamped before the floor so an edge sample blends with its own texel, not its neighbour.
  const vec2 dims = vec2(width, height);
  const vec2 coord = clamp(saturate(uv) * dims - 0.5f, vec2(0.0f), dims - 1.0f);
  const vec2 coordFloor = floor(coord);
  const vec2 filterWeight = coord - coordFloor;

  const int x0 = int(coordFloor.x);
  const int x1 = min(x0 + 1, width - 1);
  const int y0 = int(coordFloor.y);
  const int y1 = min(y0 + 1, height - 1);

  const vec3 t00 = lut.Load(int3(x0, y0, 0)).rgb;
  const vec3 t10 = lut.Load(int3(x1, y0, 0)).rgb;
  const vec3 t01 = lut.Load(int3(x0, y1, 0)).rgb;
  const vec3 t11 = lut.Load(int3(x1, y1, 0)).rgb;

  return mix(mix(t00, t10, filterWeight.x), mix(t01, t11, filterWeight.x), filterWeight.y);
}

// Parameterization from Section 4 of Bruneton and Neyret [BN08], as referenced by paper Section 5.2.
// Outputs the view zenith angle cosine and the altitude in km.
void uvToTransmittanceLutParams(vec2 uv, AtmosphereArgs args, out float viewZenithCosAngle, out float altitude) {
  const float xMu = textureCoordToUnitRange(uv.x, args.transmittanceLutWidth);
  const float xR = textureCoordToUnitRange(uv.y, args.transmittanceLutHeight);

  // Distance to the horizon, from which the altitude follows.
  float H = sqrt(max(0.0f, args.atmosphereRadius * args.atmosphereRadius - args.planetRadius * args.planetRadius));
  float rho = H * xR;
  altitude = sqrt(rho * rho + args.planetRadius * args.planetRadius) - args.planetRadius;

  // Distance to the atmosphere top boundary, and the view zenith angle that produces it.
  float r = altitude + args.planetRadius;
  float dMin = args.atmosphereRadius - r;
  float dMax = rho + H;
  float d = dMin + xMu * (dMax - dMin);

  if (d == 0.0f) {
    viewZenithCosAngle = 1.0f;
  } else {
    viewZenithCosAngle = (H * H - rho * rho - d * d) / (2.0f * r * d);
    viewZenithCosAngle = clamp(viewZenithCosAngle, -1.0f, 1.0f);
  }
}

vec2 transmittanceLutParamsToUv(float altitude, float viewZenithCosAngle, AtmosphereArgs args) {
  float H = sqrt(max(0.0f, args.atmosphereRadius * args.atmosphereRadius - args.planetRadius * args.planetRadius));
  float rho = sqrt(max(0.0f, altitude * altitude + 2.0f * args.planetRadius * altitude));

  float r = altitude + args.planetRadius;
  float mu = clamp(viewZenithCosAngle, -1.0f, 1.0f);
  float d = max(0.0f, -r * mu + sqrt(max(0.0f, r * r * (mu * mu - 1.0f) + args.atmosphereRadius * args.atmosphereRadius)));

  float dMin = max(0.0f, args.atmosphereRadius - r);
  float dMax = rho + H;

  float xMu = (d - dMin) / max(dMax - dMin, 1e-6f);
  float xR = rho / max(H, 1e-6f);

  return vec2(
    unitRangeToTextureCoord(xMu, args.transmittanceLutWidth),
    unitRangeToTextureCoord(xR, args.transmittanceLutHeight));
}

// Transmittance from an altitude along a view zenith angle to the atmosphere's top boundary. This
// ignores the planet, so callers that need the sun's visibility must combine it with evalPlanetShadow.
vec3 sampleTransmittanceLut(Texture2D transmittanceLut, float altitude, float viewZenithCosAngle, AtmosphereArgs args) {
  const vec2 uv = transmittanceLutParamsToUv(altitude, viewZenithCosAngle, args);
  return max(sampleLut2DBilinearClamp(
    transmittanceLut, uv, int(args.transmittanceLutWidth), int(args.transmittanceLutHeight)), vec3(0.0f));
}

// Psi_ms of Equation 10: the transfer function (sr^-1) that converts a directional light's illuminance
// into the contribution of every scattering order at or above two, per unit scattering coefficient. Each tile of
// the multiple scattering texture is parameterized by sun zenith angle cosine and altitude, per paper Section
// 5.5.2. The altitude axis is square root mapped rather than the paper's linear one: it puts a quarter of the
// rows in the lowest 6 km, where the aerosol layer that dominates the horizon's multiple scattering would
// otherwise fall between two rows.
float multiscatteringLutAltitudeToV(float altitude, AtmosphereArgs args) {
  return sqrt(saturate(altitude / max(args.atmosphereThickness, kAtmosphereEpsilon)));
}

float multiscatteringLutVToAltitude(float v, AtmosphereArgs args) {
  return v * v * args.atmosphereThickness;
}

// Texel coordinates within a tile, texel centres on the parameter range bounds.
vec2 multiscatteringTileCoordinate(float altitude, float sunZenithCosAngle, AtmosphereArgs args) {
  const float last = float(args.multiscatteringLutSize) - 1.0f;
  return vec2(
    saturate((clamp(sunZenithCosAngle, -1.0f, 1.0f) + 1.0f) * 0.5f) * last,
    multiscatteringLutAltitudeToV(altitude, args) * last);
}

vec4 loadMultiscatteringTile(Texture2D multiscatteringLut, int2 tile, vec2 coordinate, AtmosphereArgs args) {
  const int size = int(max(args.multiscatteringLutSize, 1u));
  const vec2 clamped = clamp(coordinate, vec2(0.0f), vec2(float(size - 1)));
  const int2 c0 = int2(floor(clamped));
  const int2 c1 = min(c0 + 1, int2(size - 1));
  const vec2 weight = clamped - vec2(c0);
  const int2 origin = tile * size;

  const vec4 t00 = multiscatteringLut.Load(int3(origin + int2(c0.x, c0.y), 0));
  const vec4 t10 = multiscatteringLut.Load(int3(origin + int2(c1.x, c0.y), 0));
  const vec4 t01 = multiscatteringLut.Load(int3(origin + int2(c0.x, c1.y), 0));
  const vec4 t11 = multiscatteringLut.Load(int3(origin + int2(c1.x, c1.y), 0));

  return mix(mix(t00, t10, weight.x), mix(t01, t11, weight.x), weight.y);
}

// The bake's isotropic estimate, the paper's Psi_ms with the real phase functions and the ground's
// interreflection in its series.
vec3 sampleMultiscatteringIsotropic(Texture2D multiscatteringLut, float altitude, float sunZenithCosAngle, AtmosphereArgs args) {
  const vec2 coordinate = multiscatteringTileCoordinate(altitude, sunZenithCosAngle, args);
  return max(loadMultiscatteringTile(multiscatteringLut, int2(0, 0), coordinate, args).rgb, vec3(0.0f));
}

// Psi_ms per species for the light that leaves a point at the given altitude against viewDir, i.e. the radiance
// field of every order past the first scattered through each species' own phase function toward the viewer
// (see multiscattering_lut.comp.slang). up is the local vertical.
void evalMultipleScatteringPsi(
  Texture2D multiscatteringLut,
  float altitude,
  vec3 up,
  vec3 viewDir,
  vec3 sunDir,
  AtmosphereArgs args,
  out vec3 rayleighPsi,
  out vec3 aerosolPsi)
{
  const float sunZenithCosAngle = clamp(dot(up, sunDir), -1.0f, 1.0f);
  const vec2 coordinate = multiscatteringTileCoordinate(altitude, sunZenithCosAngle, args);

  // Local frame of the bake: vertical, horizontal toward the sun and across. A sun at the zenith leaves the
  // field symmetric about the vertical, so any horizontal axis serves.
  vec3 towardSun = sunDir - up * sunZenithCosAngle;
  const float towardSunLength = length(towardSun);
  if (towardSunLength > 1e-4f) {
    towardSun /= towardSunLength;
  } else {
    towardSun = normalize(cross(up, abs(up.x) < 0.9f ? vec3(1.0f, 0.0f, 0.0f) : vec3(0.0f, 0.0f, 1.0f)));
  }
  const float viewVertical = clamp(dot(viewDir, up), -1.0f, 1.0f);
  const float viewTowardSun = dot(viewDir, towardSun);
  const float viewAcross = abs(dot(viewDir, cross(up, towardSun)));

  // Rayleigh: p(mu) = a + b mu^2, so its response to the field is a * trace(M) + b * v^T M v with M the field's
  // second moments, stored per channel as (toward sun^2, across^2, vertical^2, toward sun * vertical).
  const float gamma = args.rayleighPhaseGamma;
  const float scale = 3.0f / (16.0f * kPi * (1.0f + 2.0f * gamma));
  const float isotropicTerm = scale * (1.0f + 3.0f * gamma);
  const float cosineTerm = scale * (1.0f - gamma);
  const vec4 basis = vec4(
    viewTowardSun * viewTowardSun, viewAcross * viewAcross, viewVertical * viewVertical, 2.0f * viewTowardSun * viewVertical);
  rayleighPsi = vec3(0.0f);
  for (int channel = 0; channel < 3; ++channel) {
    const vec4 moments = loadMultiscatteringTile(multiscatteringLut, int2(1 + channel, 0), coordinate, args);
    rayleighPsi[channel] = isotropicTerm * (moments.x + moments.y + moments.z) + cosineTerm * dot(moments, basis);
  }
  rayleighPsi = max(rayleighPsi, vec3(0.0f));

  // Aerosol: one tile per view zenith, square root compressed toward the horizon, and azimuth from the sun.
  const float viewZenithCoordinate =
    (sign(viewVertical) * sqrt(abs(viewVertical)) + 1.0f) * 0.5f * float(ATMOSPHERE_MS_VIEW_ZENITH_COUNT - 1);
  const float azimuthCoordinate =
    saturate(atan2(viewAcross, viewTowardSun) / kPi) * float(ATMOSPHERE_MS_RELATIVE_AZIMUTH_COUNT - 1);
  const int v0 = clamp(int(viewZenithCoordinate), 0, ATMOSPHERE_MS_VIEW_ZENITH_COUNT - 2);
  const int a0 = clamp(int(azimuthCoordinate), 0, ATMOSPHERE_MS_RELATIVE_AZIMUTH_COUNT - 2);
  const float viewWeight = saturate(viewZenithCoordinate - float(v0));
  const float azimuthWeight = saturate(azimuthCoordinate - float(a0));

  const vec3 a00 = loadMultiscatteringTile(multiscatteringLut, int2(v0, 1 + a0), coordinate, args).rgb;
  const vec3 a10 = loadMultiscatteringTile(multiscatteringLut, int2(v0 + 1, 1 + a0), coordinate, args).rgb;
  const vec3 a01 = loadMultiscatteringTile(multiscatteringLut, int2(v0, 2 + a0), coordinate, args).rgb;
  const vec3 a11 = loadMultiscatteringTile(multiscatteringLut, int2(v0 + 1, 2 + a0), coordinate, args).rgb;
  aerosolPsi = max(mix(mix(a00, a10, viewWeight), mix(a01, a11, viewWeight), azimuthWeight), vec3(0.0f));
}

// Transmittance from a point in the atmosphere to the sun, combining the atmospheric shadowing term
// with the planet's own shadow. This is the S term of Equation 4.
vec3 evalSunShadowing(vec3 samplePos, vec3 sunDir, Texture2D transmittanceLut, AtmosphereArgs args) {
  if (evalPlanetShadow(samplePos, sunDir, args) <= 0.0f) {
    return vec3(0.0f);
  }

  const vec3 toSample = samplePos - getPlanetCenter(args);
  const float radius = max(length(toSample), kAtmosphereEpsilon);
  const float sunZenithCosAngle = dot(toSample / radius, sunDir);

  return sampleTransmittanceLut(
    transmittanceLut, max(radius - args.planetRadius, 0.0f), sunZenithCosAngle, args);
}

// Distributes numSamples along [t0, t1] with a power curve so steps start short near the ray origin,
// where the atmosphere is densest, and lengthen with distance. A uniform step badly under-resolves
// the 1.2 km Mie scale height that produces the horizon haze and sunset colour.
static const float kAtmosphereStepDistributionExponent = 2.0f;

float atmosphereStepFraction(float x) {
  return pow(saturate(x), kAtmosphereStepDistributionExponent);
}

// Marchable extent of a ray through the atmosphere, in km along the ray.
struct AtmosphereMarchSegment {
  float t0;
  float t1;
  bool hitsGround;  // t1 sits on the planet surface
};

// Clips a march to the atmosphere shell, the planet and the caller's window: maxDistance limits it
// (0 for the full column) and startDistance skips the near portion. Returns false when nothing is left.
bool clipAtmosphereMarch(
  vec3 rayOrigin,
  vec3 rayDir,
  AtmosphereArgs args,
  float maxDistance,
  float startDistance,
  out AtmosphereMarchSegment segment
) {
  segment.t0 = 0.0f;
  segment.t1 = 0.0f;
  segment.hitsGround = false;

  const vec3 planetCenter = getPlanetCenter(args);

  float t0, t1;
  if (!intersectSphere(rayOrigin, rayDir, planetCenter, args.atmosphereRadius, t0, t1)) {
    return false;
  }

  // Inside the shell the near root lies behind the origin.
  if (length(rayOrigin - planetCenter) < args.atmosphereRadius) {
    t0 = 0.0f;
  }

  float tPlanet0, tPlanet1;
  if (intersectSphere(rayOrigin, rayDir, planetCenter, args.planetRadius, tPlanet0, tPlanet1) && tPlanet0 > 0.0f) {
    t1 = tPlanet0;
    segment.hitsGround = true;
  }

  if (maxDistance > 0.0f && maxDistance < t1) {
    t1 = maxDistance;
    segment.hitsGround = false;
  }

  segment.t0 = max(max(0.0f, t0), startDistance);
  segment.t1 = t1;

  return segment.t1 > segment.t0;
}

// Scattering of one march step of length dt at samplePos (Equation 11), integrated analytically over
// the step against its own extinction (Equation 17): integral of exp(-sigma_t x) S dx = S (1 - T) / sigma_t.
// rayDir is the march direction, away from the viewer. sunShadowing is S(x, l) of Equation 4 times any further
// visibility the caller applies, and skyVisibility scales the multiple scattering, which stands for the sky
// light reaching the step. The running transmittance to the step is left to the caller;
// outSampleTransmittance is the step's own.
vec3 integrateAtmosphereStep(
  vec3 samplePos,
  vec3 rayDir,
  float dt,
  vec3 sunDir,
  float phaseR,
  vec3 phaseM,
  vec3 sunShadowing,
  vec3 skyVisibility,
  AtmosphereArgs args,
  Texture2D multiscatteringLut,
  out vec3 outSampleTransmittance
) {
  const vec3 planetCenter = getPlanetCenter(args);
  const float altitude = clamp(length(samplePos - planetCenter) - args.planetRadius, 0.0f, args.atmosphereThickness);
  const AtmosphereMedium medium = sampleAtmosphereMedium(altitude, args);

  // Each species scatters the sun with its own spectral weights (identical outside the Physical
  // coefficient mode), so the illuminance is applied per term rather than to their sum.
  const vec3 rayleighLight = args.sunIlluminance * medium.rayleighScattering;
  const vec3 mieLight = args.sunIlluminanceAerosol * medium.mieScattering;

  const vec3 singleScatter = sunShadowing * (rayleighLight * phaseR + mieLight * phaseM);

  // Every higher scattering order, via the Psi_ms transfer function. Equation 11 applies sigma_s and the
  // light's illuminance exactly once each, so neither is baked into the LUT.
  const vec3 up = normalize(samplePos - planetCenter);
  vec3 rayleighPsi;
  vec3 aerosolPsi;
  evalMultipleScatteringPsi(multiscatteringLut, altitude, up, rayDir, sunDir, args, rayleighPsi, aerosolPsi);
  const vec3 multiScatter = skyVisibility * (rayleighLight * rayleighPsi + mieLight * aerosolPsi);

  const vec3 scatteredLight = max(singleScatter + multiScatter, vec3(0.0f));

  outSampleTransmittance = clamp(exp(-medium.extinction * dt), vec3(0.0f), vec3(1.0f));
  const vec3 clampedExtinction = max(medium.extinction, vec3(1e-7f));

  return (scatteredLight - scatteredLight * outSampleTransmittance) / clampedExtinction;
}

// Evaluate atmosphere radiance along a ray, including every scattering order (Equation 11).
// The transmittance and multiscattering LUTs supply the expensive terms; see paper Sections 5.2/5.5.
//
// maxDistance limits the march (0 for the full atmospheric column) and startDistance skips the near
// portion, which the aerial perspective volume uses to hand off to the global volumetrics fog.
// outTransmittance receives the transmittance across the marched segment.
vec3 evalAtmosphereRadianceSegment(
  vec3 rayOrigin,
  vec3 rayDir,
  vec3 sunDir,
  AtmosphereArgs args,
  Texture2D transmittanceLut,
  Texture2D multiscatteringLut,
  Texture2D aerosolPhaseLut,
  int numSamples,
  float maxDistance,
  float startDistance,
  out vec3 outTransmittance
) {
  outTransmittance = vec3(1.0f);

  AtmosphereMarchSegment segment;
  if (!clipAtmosphereMarch(rayOrigin, rayDir, args, maxDistance, startDistance, segment)) {
    return vec3(0.0f);
  }

  const int actualSamples = clamp(numSamples, 1, 512);
  const float span = segment.t1 - segment.t0;
  const float invSamples = 1.0f / float(actualSamples);

  vec3 L = vec3(0.0f);
  vec3 transmittance = vec3(1.0f);
  
  const float cosTheta = dot(rayDir, sunDir);
  const float phaseR = rayleighPhase(cosTheta, args.rayleighPhaseGamma);
  const vec3 phaseM = miePhase(cosTheta, args, aerosolPhaseLut);
  
  float segmentStart = 0.0f;
  for (int i = 0; i < actualSamples; ++i) {
    // Non-uniform segments: dense near the origin, coarse toward the far boundary.
    const float segmentEnd = atmosphereStepFraction(float(i + 1) * invSamples);
    const float dt = (segmentEnd - segmentStart) * span;
    const float t = segment.t0 + (segmentStart + (segmentEnd - segmentStart) * 0.5f) * span;
    segmentStart = segmentEnd;

    if (dt <= 0.0f) {
      continue;
    }

    const vec3 samplePos = rayOrigin + rayDir * t;
    const vec3 sunShadowing = evalSunShadowing(samplePos, sunDir, transmittanceLut, args);

    vec3 sampleTransmittance;
    const vec3 contribution = transmittance * integrateAtmosphereStep(
      samplePos, rayDir, dt, sunDir, phaseR, phaseM, sunShadowing, vec3(1.0f), args, multiscatteringLut, sampleTransmittance);

    // Skip numerical edge cases rather than letting a NaN poison the whole ray.
    if (any(isnan(contribution)) || any(isinf(contribution))) {
      continue;
    }

    L += contribution;
    transmittance *= sampleTransmittance;
    
    if (all(transmittance < vec3(1e-4f))) {
      break;
    }
  }

  // Diffuse response of the virtual planet ground, the L_o term of Equation 1. Only for the full
  // atmospheric column: this stands in for distant terrain below the horizon when shading the sky,
  // whereas a bounded march is integrating toward real scene geometry that already supplies it.
  if (maxDistance <= 0.0f && segment.hitsGround) {
    const vec3 planetCenter = getPlanetCenter(args);
    const vec3 groundPos = rayOrigin + rayDir * segment.t1;
    const vec3 groundNormal = normalize(groundPos - planetCenter);
    const float NdotL = dot(groundNormal, sunDir);

    if (NdotL > 0.0f) {
      // Direct sunlight on the ground, hence the disc's spectral weights.
      const vec3 sunShadowing = evalSunShadowing(groundPos, sunDir, transmittanceLut, args);
      L += transmittance * args.sunDiscIlluminance * sunShadowing * NdotL * (args.groundAlbedo / kPi);
    }
  }

  outTransmittance = transmittance;

  // Final sanitization: replace any NaN/Inf with zero
  L = max(L, vec3(0.0f));
  if (any(isnan(L)) || any(isinf(L))) {
    L = vec3(0.0f);
  }

  return L;
}

// Full atmospheric column along the ray, the common case for sky radiance.
vec3 evalAtmosphereRadiance(
  vec3 rayOrigin,
  vec3 rayDir,
  vec3 sunDir,
  AtmosphereArgs args,
  Texture2D transmittanceLut,
  Texture2D multiscatteringLut,
  Texture2D aerosolPhaseLut,
  int numSamples
) {
  vec3 unusedTransmittance;
  return evalAtmosphereRadianceSegment(
    rayOrigin, rayDir, sunDir, args, transmittanceLut, multiscatteringLut, aerosolPhaseLut,
    numSamples, 0.0f, 0.0f, unusedTransmittance);
}

// Transmittance from an altitude (km above the ground) to the sun, including the planet's shadow.
// Used by the volumetrics to rescale the distant sun light with froxel height.
vec3 getTransmittanceToSunAtAltitude(float altitudeKm, Texture2D transmittanceLut, AtmosphereArgs args) {
  const vec3 samplePos = vec3(0.0f, max(altitudeKm, kPlanetRadiusOffset), 0.0f);
  return evalSunShadowing(samplePos, args.sunDirection, transmittanceLut, args);
}

// Radiance of the sun disc itself. The paper composites the disc separately from the Sky-View LUT
// (Section 5.3) because its 0.545 degree angular size cannot be resolved at LUT resolution.
//
// Peak radiance follows from the illuminance and the disc's solid angle: for a small cone of half
// angle theta, Omega ~= pi * sin^2(theta) and E = L * Omega, so L = E / (pi * sin^2(theta)). This is
// the same convention distantLightSampleArea() uses, which keeps a mirror reflection of the sun and
// a next event estimation highlight on a rough surface at matching brightness.
//
// A true Earth sun overflows the fp16 shared radiance buffers, which are neither denoised nor firefly
// filtered on the way to the output, hence the clamp. It still sits orders of magnitude past display
// white. Rough surfaces are unaffected: they take the sun from the distant light, where the cone pdf
// cancels this factor before anything is stored.
static const float kMaxSunDiscRadiance = 16384.0f;

vec3 evalSunDisk(vec3 viewDir, Texture2D transmittanceLut, AtmosphereArgs args, bool isZUp = false) {
  if (args.sunDiscEnabled == 0) {
    return vec3(0.0f);
  }

  const vec3 viewDirYUp = normalize(isZUp ? vec3(viewDir.x, viewDir.z, viewDir.y) : viewDir);

  const float cosAngle = dot(viewDirYUp, args.sunDirection);
  const float sunCosRadius = cos(args.sunAngularRadius);

  if (cosAngle < sunCosRadius) {
    return vec3(0.0f);
  }

  // Limb darkening (Hestroffer and Magnan 1998): I(mu) / I(1) = mu^alpha, mu = sqrt(1 - r^2) for the
  // normalised disc radius r. The disc mean of mu^alpha is 2 / (alpha + 2); dividing by it keeps the
  // disc's total illuminance independent of the exponent.
  const float normalizedRadius = saturate(acos(clamp(cosAngle, -1.0f, 1.0f)) / max(args.sunAngularRadius, 1e-6f));
  const float mu = sqrt(max(1.0f - normalizedRadius * normalizedRadius, 0.0f));
  const vec3 alpha = max(args.sunLimbDarkeningExponent, vec3(0.0f));
  const vec3 limbDarkening = pow(vec3(max(mu, 1e-4f)), alpha) * (alpha + 2.0f) * 0.5f;

  // Looking along the view ray rather than straight up, so the disc reddens correctly near the
  // horizon and disappears once the planet occludes it.
  const vec3 viewPos = vec3(0.0f, max(args.viewAltitude, kPlanetRadiusOffset), 0.0f);
  const vec3 transmittance = evalSunShadowing(viewPos, viewDirYUp, transmittanceLut, args);

  const float solidAngle = kPi * square(max(sin(args.sunAngularRadius), 1e-6f));

  const vec3 radiance = args.sunDiscIlluminance * transmittance * limbDarkening / solidAngle;

  return min(radiance, vec3(kMaxSunDiscRadiance));
}

// Sky radiance for a view direction, ray marched inline rather than sampled from the sky-view LUT.
vec3 evalSkyRadiance(
  vec3 viewDir,
  AtmosphereArgs args,
  Texture2D transmittanceLut,
  Texture2D multiscatteringLut,
  Texture2D aerosolPhaseLut,
  bool isZUp = false
) {
  const vec3 viewDirYUp = normalize(isZUp ? vec3(viewDir.x, viewDir.z, viewDir.y) : viewDir);

  // Camera on the local vertical at the configured altitude, in Y-up space.
  const vec3 cameraPos = vec3(0.0f, max(args.viewAltitude, kPlanetRadiusOffset), 0.0f);

  const vec3 radiance = evalAtmosphereRadiance(
    cameraPos, viewDirYUp, args.sunDirection, args, transmittanceLut, multiscatteringLut, aerosolPhaseLut,
    int(args.skyViewStepCount));

  // The sun disc is left to the caller, so paths that already sampled the sun through next event
  // estimation do not double count it.
  return max(radiance, vec3(0.0f));
}

// Latitude uses the paper's Section 5.3 compression, which concentrates texels toward the horizon
// where the sky varies fastest. These two must stay exact inverses or the horizon will shear.
float skyViewLutElevationToV(float elevation) {
  // v = 0.5 + 0.5 * sign(l) * sqrt(|l| / (pi/2))
  const float normalized = saturate(abs(elevation) / (0.5f * kPi));
  return 0.5f + 0.5f * sign(elevation) * sqrt(normalized);
}

float skyViewLutVToElevation(float v) {
  const float centered = 2.0f * clamp(v, 0.0f, 1.0f) - 1.0f;
  return sign(centered) * centered * centered * (0.5f * kPi);
}

// Sample the precomputed sky-view LUT instead of ray marching per miss ray. The bake in
// sky_view_lut.comp.slang uses the same evalAtmosphereRadiance() as evalSkyRadiance(), so this
// matches it up to LUT resolution and fp16 filtering. The LUT is a parameter because this header is
// also compiled into the bake passes, where the runtime binding does not exist.
vec3 sampleSkyViewLutRadiance(
  Texture2D skyViewLut,
  vec3 viewDir,
  AtmosphereArgs args,
  bool isZUp = false
) {
  vec3 viewDirYUp = isZUp ? vec3(viewDir.x, viewDir.z, viewDir.y) : viewDir;
  viewDirYUp = normalize(viewDirYUp);

  const float elevation = asin(clamp(viewDirYUp.y, -1.0f, 1.0f));
  float azimuth = atan2(viewDirYUp.z, viewDirYUp.x);
  if (azimuth < 0.0f)
  {
    azimuth += 2.0f * kPi;
  }

  const vec2 uv = vec2(azimuth / (2.0f * kPi), skyViewLutElevationToV(elevation));

  const int width = int(args.skyViewLutWidth);
  const int height = int(args.skyViewLutHeight);

  // Texel (i, j) stores the value for uv = ((i + 0.5) / w, (j + 0.5) / h). Azimuth wraps around;
  // elevation clamps at the poles, before the floor so the pole texel blends with itself.
  vec2 coord = uv * vec2(width, height) - 0.5f;
  coord.y = clamp(coord.y, 0.0f, float(height - 1));
  const vec2 coordFloor = floor(coord);
  const vec2 filterWeight = coord - coordFloor;

  int x0 = int(coordFloor.x);
  x0 = (x0 % width + width) % width;
  const int x1 = (x0 + 1) % width;
  const int y0 = int(coordFloor.y);
  const int y1 = min(y0 + 1, height - 1);

  const vec3 t00 = skyViewLut.Load(int3(x0, y0, 0)).rgb;
  const vec3 t10 = skyViewLut.Load(int3(x1, y0, 0)).rgb;
  const vec3 t01 = skyViewLut.Load(int3(x0, y1, 0)).rgb;
  const vec3 t11 = skyViewLut.Load(int3(x1, y1, 0)).rgb;

  const vec3 radiance = mix(mix(t00, t10, filterWeight.x), mix(t01, t11, filterWeight.x), filterWeight.y);

  return max(radiance, vec3(0.0f));
}

// Sky-view LUT ambient for volumetrics. Above-horizon only; the lower hemisphere is covered by the
// separate ground bounce lobe.
vec3 sampleSkyAmbientForVolume(vec3 dirYUp, AtmosphereArgs args, Texture2D skyViewLut) {
  if (dirYUp.y < 0.0f) {
    return vec3(0.0f);
  }
  return sampleSkyViewLutRadiance(skyViewLut, dirYUp, args, false);
}

// Aerial perspective froxel volume (paper Section 5.4). RGB holds in-scattered luminance toward the
// camera and A the mean transmittance, so applying it is a single multiply-add per pixel.
//
// The volume is fitted to the camera frustum: uv spans the screen and w indexes depth.
// cameraRight and cameraUp are pre-scaled by the frustum half extents at unit forward distance, so
// the direction below always has a forward component of exactly one.
vec3 aerialPerspectiveViewRayDirection(vec2 screenUv, AtmosphereArgs args) {
  // Screen UV has its origin at the top left, so v grows downward while cameraUp points upward.
  const vec2 ndc = vec2(screenUv.x * 2.0f - 1.0f, 1.0f - screenUv.y * 2.0f);
  return args.cameraForward + args.cameraRight * ndc.x + args.cameraUp * ndc.y;
}

// Depth slices are distributed as the cube of the slice coordinate. With 32 slices over the paper's
// 32 km, a linear split would put everything inside a city block into the first slice; the cube puts
// slice centres at roughly 0.1, 3, 15, 40 and 90 m, resolving a room's depth as well as the skyline.
static const float kAerialPerspectiveDepthPower = 3.0f;

float aerialPerspectiveSliceToForwardDistance(float w, AtmosphereArgs args) {
  return pow(saturate(w), kAerialPerspectiveDepthPower) * args.aerialPerspectiveDepthRange;
}

float aerialPerspectiveForwardDistanceToSlice(float forwardDistance, AtmosphereArgs args) {
  return saturate(pow(max(forwardDistance, 0.0f) / max(args.aerialPerspectiveDepthRange, 1e-6f), 1.0f / kAerialPerspectiveDepthPower));
}

vec3 aerialPerspectiveUvwToWorldPosition(vec3 uvw, AtmosphereArgs args) {
  const float forwardDistance = aerialPerspectiveSliceToForwardDistance(uvw.z, args);

  return args.cameraPosition + aerialPerspectiveViewRayDirection(uvw.xy, args) * forwardDistance;
}

// Inverse of aerialPerspectiveUvwToWorldPosition for a screen UV and a distance along the view ray.
vec3 aerialPerspectiveScreenUvToUvw(vec2 screenUv, float viewRayDistance, AtmosphereArgs args) {
  const vec3 direction = aerialPerspectiveViewRayDirection(screenUv, args);
  const float directionLength = max(length(direction), 1e-6f);

  // Convert the distance along the view ray into a forward (slice) distance.
  const float forwardDistance = viewRayDistance / directionLength;

  return vec3(screenUv, aerialPerspectiveForwardDistanceToSlice(forwardDistance, args));
}

// Camera altitude in the Y-up atmosphere frame for the per-frame volume, i.e. the ray origin the aerial
// perspective march starts from.
vec3 aerialPerspectiveRayOrigin(AtmosphereArgs args) {
  return vec3(0.0f, max(args.aerialPerspectiveViewAltitude, kPlanetRadiusOffset), 0.0f);
}

// Parameters for an aerial perspective march: the aerosol scaled by the stylisation knob. Only the
// medium the march samples changes; the transmittance and multiscattering LUTs it reads stay those of
// the unscaled sky, so the sun's shadowing is untouched.
AtmosphereArgs aerialPerspectiveMediumArgs(AtmosphereArgs args) {
  const float scale = max(args.aerialPerspectiveAerosolScale, 0.0f);
  args.mieScattering *= scale;
  args.mieAbsorption *= scale;
  return args;
}

// Length along a froxel ray beyond which no pixel of its screen tile can see, from the tile's farthest
// primary hit (a forward distance). Integrating no further keeps air behind a wall that fills the tile
// from reaching the wall's pixels through slice interpolation. The margin keeps the slice a surface
// sits in fully integrated.
float aerialPerspectiveMaxRayLength(float tileMaxForwardDistance, vec2 screenUv, AtmosphereArgs args) {
  const float directionLength = length(aerialPerspectiveViewRayDirection(screenUv, args));
  return tileMaxForwardDistance * directionLength * 1.05f;
}

// Tile of the volume a screen UV falls in.
int2 aerialPerspectiveTileCoordinate(vec2 screenUv, AtmosphereArgs args) {
  const int size = int(max(args.aerialPerspectiveLutSize, 1u));
  return clamp(int2(saturate(screenUv) * float(size)), int2(0), int2(size - 1));
}

// Atmosphere frame direction for a world direction. The frame is Y-up with its origin on the ground
// under the camera, so only the axes need swapping for a Z-up game.
vec3 aerialPerspectiveWorldToAtmosphereDirection(vec3 worldDirection, AtmosphereArgs args) {
  return normalize(args.isZUp != 0
    ? vec3(worldDirection.x, worldDirection.z, worldDirection.y)
    : worldDirection);
}

// Trilinear clamp-to-edge fetch of the froxel volume. Each froxel holds the integral from the camera to
// its slice centre, so inside the first slice centre the volume is extrapolated toward the identity at
// the camera (in-scatter grows linearly with distance, transmittance as a power) rather than clamped,
// which would hand every nearby surface the haze of the first slice's full depth.
vec4 sampleAerialPerspectiveLut(Texture3D aerialPerspectiveLut, vec3 uvw, AtmosphereArgs args) {
  const int size = int(max(args.aerialPerspectiveLutSize, 1u));
  const int depth = int(max(args.aerialPerspectiveLutDepth, 1u));
  const vec3 dims = vec3(size, size, depth);

  // Clamped before the floor so an edge sample blends with its own texel, not its neighbour.
  const vec3 coord = clamp(saturate(uvw) * dims - 0.5f, vec3(0.0f), dims - 1.0f);
  const vec3 coordFloor = floor(coord);
  const vec3 filterWeight = coord - coordFloor;

  const int x0 = int(coordFloor.x);
  const int x1 = min(x0 + 1, size - 1);
  const int y0 = int(coordFloor.y);
  const int y1 = min(y0 + 1, size - 1);
  const int z0 = int(coordFloor.z);
  const int z1 = min(z0 + 1, depth - 1);

  const vec4 t000 = aerialPerspectiveLut.Load(int4(x0, y0, z0, 0));
  const vec4 t100 = aerialPerspectiveLut.Load(int4(x1, y0, z0, 0));
  const vec4 t010 = aerialPerspectiveLut.Load(int4(x0, y1, z0, 0));
  const vec4 t110 = aerialPerspectiveLut.Load(int4(x1, y1, z0, 0));
  const vec4 t001 = aerialPerspectiveLut.Load(int4(x0, y0, z1, 0));
  const vec4 t101 = aerialPerspectiveLut.Load(int4(x1, y0, z1, 0));
  const vec4 t011 = aerialPerspectiveLut.Load(int4(x0, y1, z1, 0));
  const vec4 t111 = aerialPerspectiveLut.Load(int4(x1, y1, z1, 0));

  const vec4 z0Value = mix(mix(t000, t100, filterWeight.x), mix(t010, t110, filterWeight.x), filterWeight.y);
  const vec4 z1Value = mix(mix(t001, t101, filterWeight.x), mix(t011, t111, filterWeight.x), filterWeight.y);
  vec4 result = mix(z0Value, z1Value, filterWeight.z);

  // Slice w maps to distance w^p, so the fraction of the first slice centre's depth is (w / w0)^p.
  const float firstSliceCentre = 0.5f / float(depth);
  if (uvw.z < firstSliceCentre) {
    const float fraction = pow(max(uvw.z, 0.0f) / firstSliceCentre, kAerialPerspectiveDepthPower);
    result.rgb *= fraction;
    result.a = pow(max(result.a, 1e-6f), fraction);
  }

  return result;
}
