#pragma once

// Hillaire Physically-Based Atmospheric Scattering
// Based on "A Scalable and Production Ready Sky and Atmosphere Rendering Technique",
// Sebastien Hillaire, EGSR 2020. Equation numbers in comments refer to that paper.
//
// All distances are in kilometers and all coefficients in km^-1. Directions are Y-up unless a
// function documents otherwise; games with a Z-up world pass isZUp to have the swap done for them.

#include "rtx/utility/common.slangh"
#include "rtx/utility/math.slangh"
#include "rtx/pass/atmosphere/atmosphere_args.h"

// Constants
static const float kAtmosphereEpsilon = 1e-3f;
static const float kPi = 3.14159265358979323846f;
// Isotropic phase function p_u, used for every scattering order beyond the first (paper Section 5.5.1).
static const float kIsotropicPhase = 1.0f / (4.0f * kPi);
// Diffuse albedo of the virtual planet ground (paper Section 4).
static const float kGroundAlbedo = 0.3f;

// Rayleigh phase function (isotropic scattering for molecules)
float rayleighPhase(float cosTheta) {
  float factor = 3.0f / (16.0f * kPi);
  return factor * (1.0f + cosTheta * cosTheta);
}

// Henyey-Greenstein phase function (anisotropic scattering for aerosols)
float hgPhase(float cosTheta, float g) {
  // Clamp g to prevent numerical issues and complete extinction at g=1.0
  // At g=1.0, the phase function becomes 0 everywhere, making Mie scattering invisible
  g = min(g, 0.999f);
  
  float g2 = g * g;
  float numerator = 1.0f - g2;
  float denominator = 4.0f * kPi * pow(1.0f + g2 - 2.0f * g * cosTheta, 1.5f);
  return numerator / max(denominator, kAtmosphereEpsilon);
}

// Returns normalized density in [0, 1] for an altitude in km.
float exponentialDensity(float altitude, float scaleHeight) {
  return exp(-max(0.0f, altitude) / scaleHeight);
}

float rayleighDensity(float altitude, AtmosphereArgs args) {
  return exponentialDensity(altitude, args.rayleighScaleHeight);
}

float mieDensity(float altitude, AtmosphereArgs args) {
  return exponentialDensity(altitude, args.mieScaleHeight);
}

// Ozone density profile (paper Section 4): a tent function of total width 2*ozoneLayerWidth centred
// on ozoneLayerAltitude, i.e. d_o(h) = max(0, 1 - |h - 25| / 15) for Earth.
float ozoneDensity(float altitude, AtmosphereArgs args) {
  const float halfWidth = max(args.ozoneLayerWidth, kAtmosphereEpsilon);
  return max(0.0f, 1.0f - abs(altitude - args.ozoneLayerAltitude) / halfWidth);
}

// Participating medium coefficients at a given altitude.
struct AtmosphereMedium {
  vec3 rayleighScattering;
  vec3 mieScattering;
  vec3 scattering;   // Rayleigh + Mie, the sigma_s of Equation 3
  vec3 extinction;   // sigma_t = sigma_s + sigma_a, including Mie and ozone absorption
};

AtmosphereMedium sampleAtmosphereMedium(float altitude, AtmosphereArgs args) {
  const float densityR = rayleighDensity(altitude, args);
  const float densityM = mieDensity(altitude, args);
  const float densityO3 = ozoneDensity(altitude, args);

  AtmosphereMedium medium;
  medium.rayleighScattering = args.rayleighScattering * densityR;
  medium.mieScattering = args.mieScattering * densityM;
  medium.scattering = medium.rayleighScattering + medium.mieScattering;
  // Rayleigh is treated as pure scattering; Mie and ozone contribute absorption (paper Table 1).
  medium.extinction = medium.scattering
                    + args.mieAbsorption * densityM
                    + args.ozoneAbsorption * densityO3;

  return medium;
}

// Ray-sphere intersection with improved numerical stability
// Returns true if intersection exists, outputs near and far intersection distances
bool intersectSphere(vec3 origin, vec3 direction, vec3 center, float radius, out float t0, out float t1) {
  vec3 oc = origin - center;
  float a = dot(direction, direction);
  float b = 2.0f * dot(oc, direction);
  float c = dot(oc, oc) - radius * radius;
  float discriminant = b * b - 4.0f * a * c;
  
  // Use a small positive threshold to handle grazing angles more robustly
  // This prevents precision issues when ray is nearly tangent to sphere
  const float kDiscriminantEpsilon = 1e-6f;
  if (discriminant < -kDiscriminantEpsilon) {
    t0 = t1 = -1.0f;
    return false;
  }
  
  // Clamp discriminant to zero for near-tangent cases
  discriminant = max(0.0f, discriminant);
  
  float sqrtDiscriminant = sqrt(discriminant);
  float inv2A = 0.5f / max(a, 1e-7f);  // Prevent division by zero
  
  // Use numerically stable formula to avoid catastrophic cancellation
  // When b > 0, use t0 = (-b - sqrt(disc)) / 2a, then t1 = c / (a * t0)
  // When b < 0, use t1 = (-b + sqrt(disc)) / 2a, then t0 = c / (a * t1)
  if (b > 0.0f) {
    t0 = (-b - sqrtDiscriminant) * inv2A;
    t1 = (abs(t0) > 1e-6f) ? (c / (a * t0)) : ((-b + sqrtDiscriminant) * inv2A);
  } else {
    t1 = (-b + sqrtDiscriminant) * inv2A;
    t0 = (abs(t1) > 1e-6f) ? (c / (a * t1)) : ((-b - sqrtDiscriminant) * inv2A);
  }
  
  // Ensure t0 <= t1
  if (t0 > t1) {
    float temp = t0;
    t0 = t1;
    t1 = temp;
  }
  
  return true;
}

// Nearest non-negative intersection distance, or -1 when the sphere is behind or missed.
float intersectSphereNearest(vec3 origin, vec3 direction, vec3 center, float radius) {
  float t0, t1;
  if (!intersectSphere(origin, direction, center, radius, t0, t1)) {
    return -1.0f;
  }

  if (t1 < 0.0f) {
    return -1.0f;
  }

  return t0 < 0.0f ? t1 : t0;
}

// Planet centre for a Y-up frame whose origin sits on the ground.
vec3 getPlanetCenter(AtmosphereArgs args) {
  return vec3(0.0f, -args.planetRadius, 0.0f);
}

// Shadowing of the atmosphere by the planet itself, the Vis term of Equation 4. Without this the
// atmosphere stays lit from below the horizon and the Earth's shadow cast into the air at sunset
// (paper Figure 9, bottom) cannot appear.
float evalPlanetShadow(vec3 samplePos, vec3 sunDir, AtmosphereArgs args) {
  // Nudge the test sphere down slightly so samples sitting exactly on the ground are not
  // self shadowed by floating point error.
  const float shadowRadius = args.planetRadius * (1.0f - 1e-5f);
  return intersectSphereNearest(samplePos, sunDir, getPlanetCenter(args), shadowRadius) >= 0.0f
    ? 0.0f
    : 1.0f;
}

// Bruneton's half texel aware remap, so the LUT edges land exactly on the parameter range bounds.
float unitRangeToTextureCoord(float x, uint textureSize) {
  const float size = float(max(textureSize, 1u));
  return 0.5f / size + saturate(x) * (1.0f - 1.0f / size);
}

float textureCoordToUnitRange(float u, uint textureSize) {
  const float size = float(max(textureSize, 1u));
  return saturate((u - 0.5f / size) / (1.0f - 1.0f / size));
}

// Manual bilinear fetch with clamped addressing. The ray tracing passes have no sampler bound for
// the atmosphere LUTs, so all LUT reads go through Load to keep the bake and runtime paths identical.
vec3 sampleLut2DBilinearClamp(Texture2D lut, vec2 uv, int width, int height) {
  const vec2 coord = clamp(uv, vec2(0.0f), vec2(1.0f)) * vec2(width, height) - 0.5f;
  const vec2 coordFloor = floor(coord);
  const vec2 filterWeight = coord - coordFloor;

  const int x0 = clamp(int(coordFloor.x), 0, width - 1);
  const int x1 = clamp(x0 + 1, 0, width - 1);
  const int y0 = clamp(int(coordFloor.y), 0, height - 1);
  const int y1 = clamp(y0 + 1, 0, height - 1);

  const vec3 t00 = lut.Load(int3(x0, y0, 0)).rgb;
  const vec3 t10 = lut.Load(int3(x1, y0, 0)).rgb;
  const vec3 t01 = lut.Load(int3(x0, y1, 0)).rgb;
  const vec3 t11 = lut.Load(int3(x1, y1, 0)).rgb;

  return mix(mix(t00, t10, filterWeight.x), mix(t01, t11, filterWeight.x), filterWeight.y);
}

// Parameterization from Section 4 of Bruneton and Neyret [BN08], as referenced by paper Section 5.2.
// Outputs the view zenith angle cosine and the altitude in km.
void uvToTransmittanceLutParams(vec2 uv, AtmosphereArgs args, out float viewZenithCosAngle, out float altitude) {
  const float xMu = textureCoordToUnitRange(uv.x, args.transmittanceLutWidth);
  const float xR = textureCoordToUnitRange(uv.y, args.transmittanceLutHeight);

  // Distance to the horizon, from which the altitude follows.
  float H = sqrt(max(0.0f, args.atmosphereRadius * args.atmosphereRadius - args.planetRadius * args.planetRadius));
  float rho = H * xR;
  altitude = sqrt(rho * rho + args.planetRadius * args.planetRadius) - args.planetRadius;

  // Distance to the atmosphere top boundary, and the view zenith angle that produces it.
  float r = altitude + args.planetRadius;
  float dMin = args.atmosphereRadius - r;
  float dMax = rho + H;
  float d = dMin + xMu * (dMax - dMin);

  if (d == 0.0f) {
    viewZenithCosAngle = 1.0f;
  } else {
    viewZenithCosAngle = (H * H - rho * rho - d * d) / (2.0f * r * d);
    viewZenithCosAngle = clamp(viewZenithCosAngle, -1.0f, 1.0f);
  }
}

vec2 transmittanceLutParamsToUv(float altitude, float viewZenithCosAngle, AtmosphereArgs args) {
  float H = sqrt(max(0.0f, args.atmosphereRadius * args.atmosphereRadius - args.planetRadius * args.planetRadius));
  float rho = sqrt(max(0.0f, altitude * altitude + 2.0f * args.planetRadius * altitude));

  float r = altitude + args.planetRadius;
  float mu = clamp(viewZenithCosAngle, -1.0f, 1.0f);
  float d = max(0.0f, -r * mu + sqrt(max(0.0f, r * r * (mu * mu - 1.0f) + args.atmosphereRadius * args.atmosphereRadius)));

  float dMin = max(0.0f, args.atmosphereRadius - r);
  float dMax = rho + H;

  float xMu = (d - dMin) / max(dMax - dMin, 1e-6f);
  float xR = rho / max(H, 1e-6f);

  return vec2(
    unitRangeToTextureCoord(xMu, args.transmittanceLutWidth),
    unitRangeToTextureCoord(xR, args.transmittanceLutHeight));
}

// Transmittance from an altitude along a view zenith angle to the atmosphere's top boundary. This
// ignores the planet, so callers that need the sun's visibility must combine it with evalPlanetShadow.
vec3 sampleTransmittanceLut(Texture2D transmittanceLut, float altitude, float viewZenithCosAngle, AtmosphereArgs args) {
  const vec2 uv = transmittanceLutParamsToUv(altitude, viewZenithCosAngle, args);
  return max(sampleLut2DBilinearClamp(
    transmittanceLut, uv, int(args.transmittanceLutWidth), int(args.transmittanceLutHeight)), vec3(0.0f));
}

// Psi_ms of Equation 10: the transfer function (sr^-1) that converts a directional light's illuminance
// into the contribution of every scattering order at or above two. Parameterized by sun zenith angle
// cosine and altitude, per paper Section 5.5.2.
vec3 sampleMultiscatteringLut(Texture2D multiscatteringLut, float altitude, float sunZenithCosAngle, AtmosphereArgs args) {
  const float u = unitRangeToTextureCoord(
    (clamp(sunZenithCosAngle, -1.0f, 1.0f) + 1.0f) * 0.5f, args.multiscatteringLutSize);
  const float v = unitRangeToTextureCoord(
    saturate(altitude / max(args.atmosphereThickness, kAtmosphereEpsilon)), args.multiscatteringLutSize);

  return max(sampleLut2DBilinearClamp(
    multiscatteringLut, vec2(u, v), int(args.multiscatteringLutSize), int(args.multiscatteringLutSize)), vec3(0.0f));
}

// Transmittance from a point in the atmosphere to the sun, combining the atmospheric shadowing term
// with the planet's own shadow. This is the S term of Equation 4.
vec3 evalSunShadowing(vec3 samplePos, vec3 sunDir, Texture2D transmittanceLut, AtmosphereArgs args) {
  if (evalPlanetShadow(samplePos, sunDir, args) <= 0.0f) {
    return vec3(0.0f);
  }

  const vec3 toSample = samplePos - getPlanetCenter(args);
  const float radius = max(length(toSample), kAtmosphereEpsilon);
  const float sunZenithCosAngle = dot(toSample / radius, sunDir);

  return sampleTransmittanceLut(
    transmittanceLut, max(radius - args.planetRadius, 0.0f), sunZenithCosAngle, args);
}

// Distributes numSamples along [t0, t1] with a power curve so steps start short near the ray origin,
// where the atmosphere is densest, and lengthen with distance. A uniform step badly under-resolves
// the 1.2 km Mie scale height that produces the horizon haze and sunset colour.
static const float kAtmosphereStepDistributionExponent = 2.0f;

float atmosphereStepFraction(float x) {
  return pow(saturate(x), kAtmosphereStepDistributionExponent);
}

// Evaluate atmosphere radiance along a ray, including every scattering order (Equation 11).
// The transmittance and multiscattering LUTs supply the expensive terms; see paper Sections 5.2/5.5.
//
// maxDistance limits the march (0 for the full atmospheric column) and startDistance skips the near
// portion, which the aerial perspective volume uses to hand off to the global volumetrics fog.
// outTransmittance receives the transmittance across the marched segment.
vec3 evalAtmosphereRadianceSegment(
  vec3 rayOrigin,
  vec3 rayDir,
  vec3 sunDir,
  AtmosphereArgs args,
  Texture2D transmittanceLut,
  Texture2D multiscatteringLut,
  int numSamples,
  float maxDistance,
  float startDistance,
  out vec3 outTransmittance
) {
  outTransmittance = vec3(1.0f);

  const vec3 planetCenter = getPlanetCenter(args);
  float t0, t1;

  // Check if we're inside or outside the atmosphere
  float distToCenter = length(rayOrigin - planetCenter);
  bool insideAtmosphere = distToCenter < args.atmosphereRadius;
  
  // Check if ray intersects atmosphere
  if (!intersectSphere(rayOrigin, rayDir, planetCenter, args.atmosphereRadius, t0, t1)) {
    return vec3(0.0f);  // No intersection - shouldn't happen if inside
  }
  
  // If inside atmosphere, start from ray origin (t0 might be negative)
  if (insideAtmosphere) {
    t0 = 0.0f;  // Start from camera position
  }
  
  // Check if ray intersects planet
  float tPlanet0, tPlanet1;
  bool hitsPlanet = intersectSphere(rayOrigin, rayDir, planetCenter, args.planetRadius, tPlanet0, tPlanet1);
  
  // Clamp to valid range
  t0 = max(max(0.0f, t0), startDistance);
  if (hitsPlanet && tPlanet0 > 0.0f) {
    t1 = tPlanet0;  // Stop at planet surface
  }
  if (maxDistance > 0.0f) {
    t1 = min(t1, maxDistance);
  }
  
  if (t1 <= t0) {
    return vec3(0.0f);
  }

  const int actualSamples = clamp(numSamples, 1, 64);
  const float span = t1 - t0;
  const float invSamples = 1.0f / float(actualSamples);

  vec3 L = vec3(0.0f);
  vec3 transmittance = vec3(1.0f);
  
  float cosTheta = dot(rayDir, sunDir);
  float phaseR = rayleighPhase(cosTheta);
  float phaseM = hgPhase(cosTheta, args.mieAnisotropy);
  
  float segmentStart = 0.0f;
  for (int i = 0; i < actualSamples; ++i) {
    // Non-uniform segments: dense near the origin, coarse toward the far boundary.
    const float segmentEnd = atmosphereStepFraction(float(i + 1) * invSamples);
    const float dt = (segmentEnd - segmentStart) * span;
    const float t = t0 + (segmentStart + (segmentEnd - segmentStart) * 0.5f) * span;
    segmentStart = segmentEnd;

    if (dt <= 0.0f) {
      continue;
    }

    const vec3 samplePos = rayOrigin + rayDir * t;
    const float altitude = clamp(
      length(samplePos - planetCenter) - args.planetRadius, 0.0f, args.atmosphereThickness);

    const AtmosphereMedium medium = sampleAtmosphereMedium(altitude, args);

    // S(x, l) of Equation 4: atmospheric transmittance toward the sun times planet visibility.
    const vec3 sunShadowing = evalSunShadowing(samplePos, sunDir, transmittanceLut, args);

    // Single scattering, the phase weighted term of Equation 11.
    const vec3 singleScatter = sunShadowing *
      (medium.rayleighScattering * phaseR + medium.mieScattering * phaseM);

    // Every higher scattering order, via the paper's Psi_ms transfer function. Equation 11 applies
    // sigma_s and the light's illuminance exactly once each, so neither is baked into the LUT.
    const vec3 up = normalize(samplePos - planetCenter);
    const vec3 multiScatter = sampleMultiscatteringLut(
      multiscatteringLut, altitude, dot(up, sunDir), args) * medium.scattering;

    vec3 scatteredLight = args.sunIlluminance * (singleScatter + multiScatter);
    scatteredLight = max(scatteredLight, vec3(0.0f));

    // Energy-conserving analytical integration (paper Section 5.6.3, Equation 17):
    // integral of exp(-sigma_t * x) * S dx == (S - S * exp(-sigma_t * d)) / sigma_t
    const vec3 sampleTransmittance = clamp(exp(-medium.extinction * dt), vec3(0.0f), vec3(1.0f));
    const vec3 clampedExtinction = max(medium.extinction, vec3(1e-7f));
    const vec3 integScatt = (scatteredLight - scatteredLight * sampleTransmittance) / clampedExtinction;

    // Skip numerical edge cases rather than letting a NaN poison the whole ray.
    const vec3 contribution = transmittance * integScatt;
    if (any(isnan(contribution)) || any(isinf(contribution))) {
      continue;
    }

    L += contribution;
    transmittance *= sampleTransmittance;
    
    // Early exit if transmittance becomes negligible
    if (all(transmittance < vec3(1e-4f))) {
      break;
    }
  }

  // Diffuse response of the virtual planet ground, the L_o term of Equation 1. Only for the full
  // atmospheric column: this stands in for distant terrain below the horizon when shading the sky,
  // whereas a bounded march is integrating toward real scene geometry that already supplies it.
  if (maxDistance <= 0.0f && hitsPlanet && tPlanet0 > 0.0f) {
    const vec3 groundPos = rayOrigin + rayDir * tPlanet0;
    const vec3 groundNormal = normalize(groundPos - planetCenter);
    const float NdotL = dot(groundNormal, sunDir);

    if (NdotL > 0.0f) {
      const vec3 sunShadowing = evalSunShadowing(groundPos, sunDir, transmittanceLut, args);
      L += transmittance * args.sunIlluminance * sunShadowing * NdotL * (kGroundAlbedo / kPi);
    }
  }

  outTransmittance = transmittance;

  // Final sanitization: replace any NaN/Inf with zero
  L = max(L, vec3(0.0f));
  if (any(isnan(L)) || any(isinf(L))) {
    L = vec3(0.0f);
  }

  return L;
}

// Full atmospheric column along the ray, the common case for sky radiance.
vec3 evalAtmosphereRadiance(
  vec3 rayOrigin,
  vec3 rayDir,
  vec3 sunDir,
  AtmosphereArgs args,
  Texture2D transmittanceLut,
  Texture2D multiscatteringLut,
  int numSamples = 32
) {
  vec3 unusedTransmittance;
  return evalAtmosphereRadianceSegment(
    rayOrigin, rayDir, sunDir, args, transmittanceLut, multiscatteringLut,
    numSamples, 0.0f, 0.0f, unusedTransmittance);
}

// Transmittance from an altitude (km above the ground) to the sun, including the planet's shadow.
// Used by the volumetrics to rescale the distant sun light with froxel height.
vec3 getTransmittanceToSunAtAltitude(float altitudeKm, Texture2D transmittanceLut, AtmosphereArgs args) {
  const vec3 samplePos = vec3(0.0f, max(altitudeKm, 0.0f), 0.0f);
  return evalSunShadowing(samplePos, args.sunDirection, transmittanceLut, args);
}

// Radiance of the sun disc itself. The paper composites the disc separately from the Sky-View LUT
// (Section 5.3) because its 0.545 degree angular size cannot be resolved at LUT resolution.
//
// Peak radiance follows from the illuminance and the disc's solid angle: for a small cone of half
// angle theta, Omega ~= pi * sin^2(theta) and E = L * Omega, so L = E / (pi * sin^2(theta)). This is
// the same convention distantLightSampleArea() uses, which keeps a mirror reflection of the sun and
// a next event estimation highlight on a rough surface at matching brightness.
//
// A true Earth sun overflows the fp16 shared radiance buffers, which are neither denoised nor firefly
// filtered on the way to the output, hence the clamp. It still sits orders of magnitude past display
// white. Rough surfaces are unaffected: they take the sun from the distant light, where the cone pdf
// cancels this factor before anything is stored.
static const float kMaxSunDiscRadiance = 16384.0f;

vec3 evalSunDisk(vec3 viewDir, Texture2D transmittanceLut, AtmosphereArgs args, bool isZUp = false) {
  if (args.sunDiscEnabled == 0) {
    return vec3(0.0f);
  }

  const vec3 viewDirYUp = normalize(isZUp ? vec3(viewDir.x, viewDir.z, viewDir.y) : viewDir);

  const float cosAngle = dot(viewDirYUp, args.sunDirection);
  const float sunCosRadius = cos(args.sunAngularRadius);

  if (cosAngle < sunCosRadius) {
    return vec3(0.0f);
  }

  // Limb darkening across the visible disc.
  const float normalizedAngle = saturate(acos(clamp(cosAngle, -1.0f, 1.0f)) / max(args.sunAngularRadius, 1e-6f));
  const float limbDarkening = max(1.0f - 0.6f * normalizedAngle * normalizedAngle, 0.0f);

  // Looking along the view ray rather than straight up, so the disc reddens correctly near the
  // horizon and disappears once the planet occludes it.
  const vec3 viewPos = vec3(0.0f, max(args.viewAltitude, 0.0f), 0.0f);
  const vec3 transmittance = evalSunShadowing(viewPos, viewDirYUp, transmittanceLut, args);

  const float solidAngle = kPi * square(max(sin(args.sunAngularRadius), 1e-6f));

  const vec3 radiance = args.sunIlluminance * transmittance * limbDarkening / solidAngle;

  return min(radiance, vec3(kMaxSunDiscRadiance));
}

// Sky radiance for a view direction, ray marched inline rather than sampled from the sky-view LUT.
vec3 evalSkyRadiance(
  vec3 viewDir,
  AtmosphereArgs args,
  Texture2D transmittanceLut,
  Texture2D multiscatteringLut,
  bool isZUp = false
) {
  const vec3 viewDirYUp = normalize(isZUp ? vec3(viewDir.x, viewDir.z, viewDir.y) : viewDir);

  // Camera on the local vertical at the configured altitude, in Y-up space.
  const vec3 cameraPos = vec3(0.0f, max(args.viewAltitude, 0.0f), 0.0f);

  const vec3 radiance = evalAtmosphereRadiance(
    cameraPos, viewDirYUp, args.sunDirection, args, transmittanceLut, multiscatteringLut, 32);

  // The sun disc is left to the caller, so paths that already sampled the sun through next event
  // estimation do not double count it.
  return max(radiance, vec3(0.0f));
}

// Latitude uses the paper's Section 5.3 compression, which concentrates texels toward the horizon
// where the sky varies fastest. These two must stay exact inverses or the horizon will shear.
float skyViewLutElevationToV(float elevation) {
  // v = 0.5 + 0.5 * sign(l) * sqrt(|l| / (pi/2))
  const float normalized = saturate(abs(elevation) / (0.5f * kPi));
  return 0.5f + 0.5f * sign(elevation) * sqrt(normalized);
}

float skyViewLutVToElevation(float v) {
  const float centered = 2.0f * clamp(v, 0.0f, 1.0f) - 1.0f;
  return sign(centered) * centered * centered * (0.5f * kPi);
}

// Sample the precomputed sky-view LUT instead of ray marching per miss ray. The bake in
// sky_view_lut.comp.slang uses the same evalAtmosphereRadiance() as evalSkyRadiance(), so this
// matches it up to LUT resolution and fp16 filtering. The LUT is a parameter because this header is
// also compiled into the bake passes, where the runtime binding does not exist.
vec3 sampleSkyViewLutRadiance(
  Texture2D skyViewLut,
  vec3 viewDir,
  AtmosphereArgs args,
  bool isZUp = false
) {
  vec3 viewDirYUp = isZUp ? vec3(viewDir.x, viewDir.z, viewDir.y) : viewDir;
  viewDirYUp = normalize(viewDirYUp);

  const float elevation = asin(clamp(viewDirYUp.y, -1.0f, 1.0f));
  float azimuth = atan2(viewDirYUp.z, viewDirYUp.x);
  if (azimuth < 0.0f)
  {
    azimuth += 2.0f * kPi;
  }

  const vec2 uv = vec2(azimuth / (2.0f * kPi), skyViewLutElevationToV(elevation));

  const int width = int(args.skyViewLutWidth);
  const int height = int(args.skyViewLutHeight);

  // Texel (i, j) stores the value for uv = ((i + 0.5) / w, (j + 0.5) / h)
  const vec2 coord = uv * vec2(width, height) - 0.5f;
  const vec2 coordFloor = floor(coord);
  const vec2 filterWeight = coord - coordFloor;

  int x0 = int(coordFloor.x);
  int y0 = int(coordFloor.y);
  // Azimuth wraps around; elevation clamps at the poles
  x0 = (x0 % width + width) % width;
  const int x1 = (x0 + 1) % width;
  y0 = clamp(y0, 0, height - 1);
  const int y1 = clamp(y0 + 1, 0, height - 1);

  const vec3 t00 = skyViewLut.Load(int3(x0, y0, 0)).rgb;
  const vec3 t10 = skyViewLut.Load(int3(x1, y0, 0)).rgb;
  const vec3 t01 = skyViewLut.Load(int3(x0, y1, 0)).rgb;
  const vec3 t11 = skyViewLut.Load(int3(x1, y1, 0)).rgb;

  const vec3 radiance = mix(mix(t00, t10, filterWeight.x), mix(t01, t11, filterWeight.x), filterWeight.y);

  return max(radiance, vec3(0.0f));
}

// Sky-view LUT ambient for volumetrics. Above-horizon only; the lower hemisphere is covered by the
// separate ground bounce lobe.
vec3 sampleSkyAmbientForVolume(vec3 dirYUp, AtmosphereArgs args, Texture2D skyViewLut) {
  if (dirYUp.y < 0.0f) {
    return vec3(0.0f);
  }
  return sampleSkyViewLutRadiance(skyViewLut, dirYUp, args, false);
}

// Aerial perspective froxel volume (paper Section 5.4). RGB holds in-scattered luminance toward the
// camera and A the mean transmittance, so applying it is a single multiply-add per pixel.
//
// The volume is fitted to the camera frustum: uv spans the screen and w indexes depth.
// cameraRight and cameraUp are pre-scaled by the frustum half extents at unit forward distance, so
// the direction below always has a forward component of exactly one.
vec3 aerialPerspectiveViewRayDirection(vec2 screenUv, AtmosphereArgs args) {
  // Screen UV has its origin at the top left, so v grows downward while cameraUp points upward.
  const vec2 ndc = vec2(screenUv.x * 2.0f - 1.0f, 1.0f - screenUv.y * 2.0f);
  return args.cameraForward + args.cameraRight * ndc.x + args.cameraUp * ndc.y;
}

// Depth slices are distributed quadratically rather than uniformly. With 32 slices over the paper's
// 32 km range, a linear split would put everything inside a city block into the first slice; squaring
// gives the nearest slice tens of metres while still reaching the far end of the range.
float aerialPerspectiveSliceToForwardDistance(float w, AtmosphereArgs args) {
  return square(saturate(w)) * args.aerialPerspectiveDepthRange;
}

float aerialPerspectiveForwardDistanceToSlice(float forwardDistance, AtmosphereArgs args) {
  return saturate(sqrt(max(forwardDistance, 0.0f) / max(args.aerialPerspectiveDepthRange, 1e-6f)));
}

vec3 aerialPerspectiveUvwToWorldPosition(vec3 uvw, AtmosphereArgs args) {
  const float forwardDistance = aerialPerspectiveSliceToForwardDistance(uvw.z, args);

  return args.cameraPosition + aerialPerspectiveViewRayDirection(uvw.xy, args) * forwardDistance;
}

// Inverse of aerialPerspectiveUvwToWorldPosition for a screen UV and a distance along the view ray.
vec3 aerialPerspectiveScreenUvToUvw(vec2 screenUv, float viewRayDistance, AtmosphereArgs args) {
  const vec3 direction = aerialPerspectiveViewRayDirection(screenUv, args);
  const float directionLength = max(length(direction), 1e-6f);

  // Convert the distance along the view ray into a forward (slice) distance.
  const float forwardDistance = viewRayDistance / directionLength;

  return vec3(screenUv, aerialPerspectiveForwardDistanceToSlice(forwardDistance, args));
}

vec4 sampleAerialPerspectiveLut(Texture3D aerialPerspectiveLut, vec3 uvw, AtmosphereArgs args) {
  const int size = int(max(args.aerialPerspectiveLutSize, 1u));

  const vec3 coord = clamp(uvw, vec3(0.0f), vec3(1.0f)) * float(size) - 0.5f;
  const vec3 coordFloor = floor(coord);
  const vec3 filterWeight = coord - coordFloor;

  const int x0 = clamp(int(coordFloor.x), 0, size - 1);
  const int x1 = clamp(x0 + 1, 0, size - 1);
  const int y0 = clamp(int(coordFloor.y), 0, size - 1);
  const int y1 = clamp(y0 + 1, 0, size - 1);
  const int z0 = clamp(int(coordFloor.z), 0, size - 1);
  const int z1 = clamp(z0 + 1, 0, size - 1);

  const vec4 t000 = aerialPerspectiveLut.Load(int4(x0, y0, z0, 0));
  const vec4 t100 = aerialPerspectiveLut.Load(int4(x1, y0, z0, 0));
  const vec4 t010 = aerialPerspectiveLut.Load(int4(x0, y1, z0, 0));
  const vec4 t110 = aerialPerspectiveLut.Load(int4(x1, y1, z0, 0));
  const vec4 t001 = aerialPerspectiveLut.Load(int4(x0, y0, z1, 0));
  const vec4 t101 = aerialPerspectiveLut.Load(int4(x1, y0, z1, 0));
  const vec4 t011 = aerialPerspectiveLut.Load(int4(x0, y1, z1, 0));
  const vec4 t111 = aerialPerspectiveLut.Load(int4(x1, y1, z1, 0));

  const vec4 z0Value = mix(mix(t000, t100, filterWeight.x), mix(t010, t110, filterWeight.x), filterWeight.y);
  const vec4 z1Value = mix(mix(t001, t101, filterWeight.x), mix(t011, t111, filterWeight.x), filterWeight.y);

  return mix(z0Value, z1Value, filterWeight.z);
}
