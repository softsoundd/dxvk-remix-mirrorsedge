#pragma once

// Two real signals a and b transformed together as one complex signal z = a + i b (Press et al., Numerical Recipes,
// section 12.3). Their spectra separate using the mirrored frequency N - k:
// A(k) = (Z(k) + conj(Z(N - k))) / 2, B(k) = (Z(k) - conj(Z(N - k))) / 2i.
// An image packs four channels into two complex values per texel: R + iG and B + iA.

float2 complexConjugate(float2 z)
{
  return float2(z.x, -z.y);
}

float2 complexMultiply(float2 a, float2 b)
{
  return float2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

void unpackRealPair(float2 zk, float2 zNk, out float2 a, out float2 b)
{
  const float2 mirrored = complexConjugate(zNk);
  const float2 difference = zk - mirrored;

  a = 0.5f * (zk + mirrored);
  // Dividing by i rotates by -90 degrees.
  b = 0.5f * float2(difference.y, -difference.x);
}

float2 packRealPair(float2 a, float2 b)
{
  return a + float2(-b.y, b.x);
}

// The spectrum of a packed image convolved with a packed real kernel, channel by channel: each channel's kernel is
// scaled by scale, less centerTap times a delta. zk and mk are taken at frequency k, zNk and mNk at N - k.
float4 convolveRealPairs(float4 zk, float4 zNk, float4 mk, float4 mNk, float4 scale, float4 centerTap)
{
  float2 r, g, b, a;
  float2 kernelR, kernelG, kernelB, kernelA;
  unpackRealPair(zk.xy, zNk.xy, r, g);
  unpackRealPair(zk.zw, zNk.zw, b, a);
  unpackRealPair(mk.xy, mNk.xy, kernelR, kernelG);
  unpackRealPair(mk.zw, mNk.zw, kernelB, kernelA);

  r = complexMultiply(r, kernelR) * scale.x - centerTap.x * r;
  g = complexMultiply(g, kernelG) * scale.y - centerTap.y * g;
  b = complexMultiply(b, kernelB) * scale.z - centerTap.z * b;
  a = complexMultiply(a, kernelA) * scale.w - centerTap.w * a;

  return float4(packRealPair(r, g), packRealPair(b, a));
}
